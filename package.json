{
  "name": "coverage-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "scan": "node --env-file-if-exists=.env.local --import tsx agent/run.ts scan",
    "agent:list": "node --env-file-if-exists=.env.local --import tsx agent/run.ts list",
    "agent:ledger": "node --env-file-if-exists=.env.local --import tsx agent/run.ts ledger"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@types/react-simple-maps": "^3.0.6",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-simple-maps": "^3.0.0",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  },
  "description": "A live 50-state scan of Medicaid coverage policy, built on TinyFish primitives."
}
